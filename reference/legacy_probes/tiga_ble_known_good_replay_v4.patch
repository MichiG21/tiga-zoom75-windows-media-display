+const KNOWN_GOOD_STREAM: &[u8] = include_bytes!("../../extracted/session_01_bulk_stream.bin");
+const KNOWN_GOOD_STREAM_LEN: usize = 220_649;
+const FILE_START_IN_STREAM: usize = 25;
+const CAPTURED_BULK_WRITES: usize = 1_239;
+const REPLAY_PACING_MS: u64 = 16;
+
+fn xor8(data: &[u8]) -> u8 {
+    data.iter().fold(0u8, |acc, b| acc ^ b)
+}
+
+fn build_known_good_chunks() -> Result<Vec<Vec<u8>>, Box<dyn Error>> {
+    let stream = KNOWN_GOOD_STREAM;
+    if stream.len() != KNOWN_GOOD_STREAM_LEN {
+        return Err(format!("Known-good bulk stream has {} bytes, expected {}", stream.len(), KNOWN_GOOD_STREAM_LEN).into());
+    }
+    if stream.get(0..8) != Some(&[0x88,0x00,0x00,0x00,0x03,0x5d,0xe1,0x00][..]) {
+        return Err("Known-good stream outer 0x88 envelope does not match capture".into());
+    }
+    if stream.get(8..25) != Some(&[0x08,0x05,0x01,0x00,0x09,0x00,0xff,0xff,0xff,0x00,0xff,0xff,0xff,0x02,0x02,0xff,0xff][..]) {
+        return Err("Known-good upload preamble does not match capture".into());
+    }
+    if stream.get(25..33) != Some(&[0x00,0x44,0x4c,0x58,0xfc,0xff,0x00,0x00][..]) {
+        return Err("Known-good DLX prefix does not match capture".into());
+    }
+    if stream.get(stream.len()-4..stream.len()) != Some(&[0xfc,0xff,0x00,0x00][..]) {
+        return Err("Known-good DLX trailer does not match capture".into());
+    }
+
+    // File starts after the 8-byte outer envelope + 17-byte upload preamble.
+    // PocketWuque used at most 181 data bytes per GATT write and shortened a write
+    // whenever necessary so it ended exactly on a 4096-byte boundary relative to
+    // the start of the DLX file. One XOR checksum byte is appended to every write.
+    let mut chunks = Vec::new();
+    let mut off = 0usize;
+    while off < stream.len() {
+        let mut n = 181usize.min(stream.len() - off);
+        if off >= FILE_START_IN_STREAM {
+            let file_rel = off - FILE_START_IN_STREAM;
+            let to_boundary = 4096 - (file_rel % 4096);
+            n = n.min(to_boundary);
+        }
+        let data = &stream[off..off+n];
+        let mut value = Vec::with_capacity(n + 1);
+        value.extend_from_slice(data);
+        value.push(xor8(data));
+        if xor8(&value) != 0 {
+            return Err(format!("Internal XOR failure while constructing chunk {}", chunks.len()).into());
+        }
+        chunks.push(value);
+        off += n;
+    }
+
+    let n182 = chunks.iter().filter(|c| c.len() == 182).count();
+    let n115 = chunks.iter().filter(|c| c.len() == 115).count();
+    let n140 = chunks.iter().filter(|c| c.len() == 140).count();
+    let n98  = chunks.iter().filter(|c| c.len() == 98).count();
+    if chunks.len() != CAPTURED_BULK_WRITES || n182 != 1185 || n115 != 52 || n140 != 1 || n98 != 1 {
+        return Err(format!(
+            "Chunk reconstruction differs from capture: total={}, len182={}, len115={}, len140={}, len98={}",
+            chunks.len(), n182, n115, n140, n98
+        ).into());
+    }
+    Ok(chunks)
+}
