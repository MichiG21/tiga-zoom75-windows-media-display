+    println!("Write pacing         : {} ms between writes (~captured conservative rate)", REPLAY_PACING_MS);
+    println!("Expected completion  : 88 00 00 00 00 00 03 0c 08 06 02");
+    println!("No retries are used for bulk writes; a host-side write error aborts the replay.");
+}
