@@ -102,6 +110,75 @@
     println!("  notify  0004   : {}", if expected[3] { "FOUND" } else { "MISSING" });
     println!("\nNO media/control characteristic writes were sent.");
 
+    if listen {
+        if !expected[1] || !expected[3] {
+            peripheral.disconnect().await?;
+            return Err("Cannot listen: one or both expected notify characteristics are missing".into());
+        }
+
+        let characteristics = peripheral.characteristics();
+        let notify1 = characteristics
+            .iter()
+            .find(|ch| ch.uuid == CHAR_NOTIFY)
+            .cloned()
+            .ok_or("Notify characteristic 0002 disappeared after discovery")?;
+        let notify2 = characteristics
+            .iter()
+            .find(|ch| ch.uuid == CHAR_NOTIFY2)
+            .cloned()
+            .ok_or("Notify characteristic 0004 disappeared after discovery")?;
+
+        println!("\nLISTEN MODE");
+        println!("Subscribing to 0002 and 0004 for {listen_secs}s...");
+        println!("NOTE: subscribing writes each characteristic's CCCD, as required by BLE GATT.");
+        println!("No TIGA application-level control or media characteristic values are written.");
+
+        let mut notifications = peripheral.notifications().await?;
+        peripheral.subscribe(&notify1).await?;
+        peripheral.subscribe(&notify2).await?;
+        println!("Subscriptions active. You may leave the keyboard idle or use its normal controls.");
+
+        let deadline = sleep(Duration::from_secs(listen_secs));
+        tokio::pin!(deadline);
+        let mut count = 0usize;
+        loop {
+            tokio::select! {
+                _ = &mut deadline => break,
+                maybe = notifications.next() => {
+                    match maybe {
+                        Some(n) => {
+                            count += 1;
+                            let role = if n.uuid == CHAR_NOTIFY {
+                                "0002/status"
+                            } else if n.uuid == CHAR_NOTIFY2 {
+                                "0004/second"
+                            } else {
+                                "other"
+                            };
+                            let hex = n.value.iter()
+                                .map(|b| format!("{b:02x}"))
+                                .collect::<Vec<_>>()
+                                .join(" ");
+                            println!("RX #{count:03} {role} {} bytes: {hex}", n.value.len());
+                        }
+                        None => {
+                            println!("Notification stream ended before timeout.");
+                            break;
+                        }
+                    }
+                }
+            }
+        }
+
+        println!("Listen window complete: {count} notification(s) received.");
+        if let Err(e) = peripheral.unsubscribe(&notify1).await {
+            println!("Warning: unsubscribe 0002 failed: {e}");
+        }
+        if let Err(e) = peripheral.unsubscribe(&notify2).await {
+            println!("Warning: unsubscribe 0004 failed: {e}");
+        }
+    }
+
     peripheral.disconnect().await?;
     println!("Disconnected cleanly.");
     Ok(())
